# Server only. Never use VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 0 uses deterministic local rules. 1 enables the server planner.
ALLY_AI_ENABLED=1
# Optional: show Ally by default; ?ally=1 also enables it for a demo.
VITE_ALLY_ENABLED=0
# Dashboard Next server. Open it through Shopee /dashboard for the shared bus.
ALLY_DASHBOARD_ORIGIN=http://127.0.0.1:3000
PORT=5173
