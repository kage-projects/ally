{
  "name": "shopee-reference-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dashboard:dev": "node scripts/live-dashboard.mjs",
    "dashboard:prepare": "node scripts/live-dashboard.mjs --prepare-only",
    "dev": "vite",
    "build": "vite build",
    "visual:check": "node scripts/visual-check.mjs",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "assets:extract": "node scripts/extract-reference-assets.mjs && node scripts/extract-mobile-assets.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "sdk:build": "node scripts/build-ally.mjs"
  },
  "dependencies": {
    "@ally/react": "file:vendor/ally-react-0.1.1-shopee.7.tgz",
    "lucide-react": "0.469.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "playwright": "1.65.0",
    "vite": "5.4.21"
  }
}
