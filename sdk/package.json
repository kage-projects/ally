{
  "name": "@ally/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "files": ["dist", "README.md", "docs/USAGE.md", "docs/HOST_PLANNER_HANDOFF.md"],
  "sideEffects": ["./dist/styles.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "node test/verify-contract.mjs",
    "test:package": "node test/consumer-package.mjs",
    "test:ai": "node test/ai-eval.mjs",
    "test:ai:mock": "node test/ai-eval.mjs --mock"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
